{
  "seed": 42,
  "assets": ["SPY", "AAPL", "MSFT", "GOOGL", "AMZN", "BTC-USD"],
  "start": "2015-01-01",
  "end": "2025-01-01",
  "data_dir": "data",
  "train_window": 756,
